---
// Utils
import { getImage } from "astro:assets";

// Components
import BaseLayout from "@/layouts/BaseLayout.astro";
import AboutHero from "@/components/About/AboutHero.astro";
import AboutStory from "@/components/About/AboutStory.astro";
import AboutCredentials from "@/components/About/AboutCredentials.astro";
import AboutHowWeWork from "@/components/About/AboutHowWeWork.astro";
import ServicesClosingCta from "@/components/CTA/ServicesClosingCta.astro";
import ContactForm from "@/components/Contact/ContactForm.astro";
import CareersCallout from "@/components/Careers/CareersCallout.astro";

// Images
import landingImage from "@/assets/images/gallery/installation/installation.jpg";
const optimizedImage = await getImage({ src: landingImage, format: "webp" });
---

<BaseLayout heroImage={optimizedImage}>
  <AboutHero image={optimizedImage} />
  <AboutStory variant="editorial" />
  <AboutCredentials />
  <AboutHowWeWork />
  <CareersCallout variant="navy" />
  <ContactForm />
  <ServicesClosingCta />
</BaseLayout>
