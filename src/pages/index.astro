---
// Utils
import { getImage } from "astro:assets";

// Components
import BaseLayout from "@/layouts/BaseLayout.astro";
import CareersCallout from "@/components/Careers/CareersCallout.astro";
import SimpleFAQ from "@/components/FAQ/SimpleFAQ.astro";
import Gallery from "@/components/Gallery/Gallery.astro";
import Hero from "@/components/Hero/Hero.astro";
import OurProcess from "@/components/Process/OurProcess.astro";
import ServiceGrid from "@/components/Services/ServiceGrid.astro";
import TrustSBS from "@/components/SideBySide/trustSBS.astro";
import ServicesClosingCta from "@/components/CTA/ServicesClosingCta.astro";
import WhyChooseUs from "@/components/WhyChoose/WhyChooseUs.astro";

import heroImage from "@/assets/images/gallery/installation/installation3.jpg";

import { getHomeFaqSchema } from "@/data/homeFaq";

// Generate one candidate set for the hero, its preload, and the trust photo.
const optimizedHeroImage = await getImage({
  src: heroImage,
  format: "webp",
  layout: "none",
  width: 960,
  widths: [320, 480, 640, 768, 960, 1280, 1536],
});
const heroImageSizes =
  "(min-width: 64rem) 50vw, (min-width: 40rem) calc(100vw - 4rem), 90vw";
const homeFaqSchema = getHomeFaqSchema();
---

<BaseLayout heroImage={optimizedHeroImage} heroImageSizes={heroImageSizes}>
  <script
    slot="schema"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(homeFaqSchema)}
  />
  <Hero image={optimizedHeroImage} sizes={heroImageSizes} />
  <ServiceGrid />
  <TrustSBS trustImg={optimizedHeroImage} />
  <WhyChooseUs />
  <OurProcess />
  <Gallery />
  <CareersCallout variant="navy" />
  <SimpleFAQ />
  <ServicesClosingCta />
</BaseLayout>
