---
import { OG, SITE } from "@/data/client";
import { getLocalBusinessSchema } from "@/js/localBusinessSchema.js";
import { getPageSeo, getSocialImage, type SocialImage } from "@/lib/seo";

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  socialImage?: SocialImage;
}

const page = getPageSeo(Astro.url.pathname);
const {
  title = page?.title ?? SITE.title,
  description = page?.description ?? SITE.description,
  ogTitle = page?.ogTitle ?? title,
  ogDescription = page?.ogDescription ?? description,
  socialImage = await getSocialImage(Astro.url.pathname),
} = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const imageUrl = new URL(socialImage.src, SITE.url).href;
const localBusinessSchema = getLocalBusinessSchema();
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="web_author" content={SITE.author} />
<link rel="canonical" href={canonical} />

<script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
<slot name="schema" />

<meta property="og:locale" content={OG.locale} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content="website" />
<meta property="og:title" content={ogTitle} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:description" content={ogDescription} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:secure_url" content={imageUrl} />
<meta property="og:image:width" content={String(socialImage.width)} />
<meta property="og:image:height" content={String(socialImage.height)} />
<meta property="og:image:type" content={socialImage.type} />
<meta property="og:image:alt" content={socialImage.alt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDescription} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={socialImage.alt} />

<link rel="apple-touch-icon" sizes="180x180" href="/assets/favicons/apple-touch-icon.png?v=rod-20261022" />
<link rel="icon" type="image/png" sizes="96x96" href="/assets/favicons/favicon-96x96.png?v=rod-20261022" />
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicons/favicon-32x32.png?v=rod-20261022" />
<link rel="icon" type="image/png" sizes="16x16" href="/assets/favicons/favicon-16x16.png?v=rod-20261022" />
<link rel="icon" type="image/x-icon" href="/assets/favicons/favicon.ico?v=rod-20261022" />
<link rel="manifest" href="/assets/favicons/site.webmanifest" />
<meta name="msapplication-TileColor" content="#082c50" />
<meta name="theme-color" content="#082c50" />
