---
import { Icon } from "astro-icon/components";

const cards = [
  {
    icon: "tabler:shield-check",
    title: "Licensed & Insured",
    body: "Master Electrician credentials and full insurance on every job, so you stay protected from quote to walkthrough.",
  },
  {
    icon: "tabler:map-pin",
    title: "Edmonton Local",
    body: "Born and based in Edmonton. We know the local code, the climate, and the housing stock from older homes to new builds.",
  },
  {
    icon: "tabler:plug",
    title: "Safety First",
    body: "Code-minded installs, clean wiring practices, and careful diagnostics that fix root causes instead of patching symptoms.",
  },
  {
    icon: "tabler:message-circle-2",
    title: "Clear Communication",
    body: "Honest pricing, plain explanations, and timely updates from first call through the final walkthrough.",
  },
];
---

<section
  id="why-choose-us"
  class="py-section relative isolate overflow-hidden bg-white px-5 sm:px-6 lg:px-8"
  aria-labelledby="why-choose-us-title"
>
  <div
    class="bg-accent/10 pointer-events-none absolute top-12 right-0 h-56 w-56 translate-x-1/4 rounded-full blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="bg-primary/8 pointer-events-none absolute bottom-12 left-0 h-56 w-56 -translate-x-1/4 rounded-full blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-7xl">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-topper text-accent m-0 uppercase">Why Rod&apos;s Electrical</p>
      <h2
        id="why-choose-us-title"
        class="text-section-title text-primary m-0 mt-3 text-balance uppercase"
      >
        Trusted Electrical Work in Edmonton
      </h2>
      <p
        class="text-section-body text-copy-muted m-0 mx-auto mt-5 max-w-[44rem]"
      >
        Hundreds of homes and businesses across the city rely on us for safe,
        code-minded electrical work delivered with consistent communication.
      </p>
    </div>

    <ul
      class="mx-0 mt-12 grid list-none gap-6 p-0 sm:grid-cols-2 lg:mt-14 lg:grid-cols-4"
    >
      {
        cards.map((card) => (
          <li class="group relative flex flex-col rounded-[1.6rem] border border-slate-200 bg-white p-6 shadow-[0_18px_42px_rgba(15,23,42,0.06)] transition duration-300 hover:-translate-y-1 hover:border-[rgba(255,204,1,0.55)] hover:shadow-[0_22px_50px_rgba(15,23,42,0.12)]">
            <span
              class="bg-accent/15 text-primary inline-flex h-14 w-14 items-center justify-center rounded-2xl"
              aria-hidden="true"
            >
              <Icon name={card.icon} class="size-7" />
            </span>
            <h3 class="text-primary mt-5 text-[1.18rem] leading-snug font-bold">
              {card.title}
            </h3>
            <p class="mt-3 text-[0.95rem] leading-7 text-slate-600">
              {card.body}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
